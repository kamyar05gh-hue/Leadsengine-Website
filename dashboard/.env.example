# LOCAL DEVELOPMENT ONLY.
#
# In production the dashboard does NOT read a PostHog key from here. A
# personal API key grants full read/write access to the whole project, and
# Vite inlines every `VITE_*` value into the client bundle — so shipping one
# this way publishes it to anyone who opens /dashboard/ and views source.
#
# Production instead posts HogQL to `/api/posthog.php`, which reads the key
# from a JSON file OUTSIDE the web root and attaches it server-side. See the
# header comment in frontend/public/api/posthog.php. That endpoint sits
# behind the same HTTP Basic auth as /dashboard/ itself — without it, the
# proxy would be an open HogQL endpoint against the project, which is worse
# than the leaked key it replaces.
#
# Fill these in only to run the dashboard against PostHog directly from a dev
# machine, and never commit a filled-in .env (it is gitignored).

# PostHog host. EU cloud by default.
VITE_POSTHOG_HOST=https://eu.posthog.com

# PostHog project ID (numeric — Project Settings → Project ID).
VITE_POSTHOG_PROJECT_ID=

# PostHog personal API key (phx_...). Dev only — see the note above.
VITE_POSTHOG_PERSONAL_KEY=

# Hostname whose $pageview events this dashboard reports on.
VITE_POSTHOG_SITE_HOST=leadsengine.ch
